# Copy to .env for local development. Never commit the real .env.
# See docs/architecture.md and the ADRs in docs/adr/ for what each value governs.

# --- Database (ADR-0002, ADR-0011) ---------------------------------------
# Local docker-compose Postgres. In deploy, this is the Neon pooled connection
# string - KEEP the "+psycopg" scheme (SQLAlchemy needs the driver named; Neon
# hands you a bare "postgresql://" which would select the uninstalled psycopg2).
DATABASE_URL=postgresql+psycopg://tortoiseandhire:tortoiseandhire@localhost:5432/tortoiseandhire

# --- Auth (ADR-0008: server-side only, never shipped to a client) --------
TORTOISEANDHIRE_API_TOKEN=change-me-to-a-long-random-value

# --- App -------------------------------------------------------------------
TORTOISEANDHIRE_ENV=development          # development | production
TORTOISEANDHIRE_LOG_LEVEL=INFO
TORTOISEANDHIRE_TIMEZONE=America/New_York

# --- Ingestion (ADR-0002, ADR-0009) -----------------------------------------
TORTOISEANDHIRE_DISCOVERY_RULESET_PATH=config/discovery.yml
TORTOISEANDHIRE_SOURCES_CONFIG_PATH=config/sources.yml

# --- Observability -----------------------------------------------------------
TORTOISEANDHIRE_METRICS_ENABLED=true
