# Copy to .env for local development. Never commit the real .env.
# See docs/architecture.md and the ADRs in docs/adr/ for what each value governs.

# --- Database (ADR-0002, ADR-0011) ---------------------------------------
# Local docker-compose Postgres. In deploy, this is the Neon pooled connection string.
DATABASE_URL=postgresql+psycopg://jobscout:jobscout@localhost:5432/jobscout

# --- Auth (ADR-0008: server-side only, never shipped to a client) --------
JOBSCOUT_API_TOKEN=change-me-to-a-long-random-value

# --- App -------------------------------------------------------------------
JOBSCOUT_ENV=development          # development | production
JOBSCOUT_LOG_LEVEL=INFO
JOBSCOUT_TIMEZONE=America/New_York

# --- Ingestion (ADR-0002, ADR-0009) -----------------------------------------
JOBSCOUT_DISCOVERY_RULESET_PATH=config/discovery.yml

# --- Observability -----------------------------------------------------------
JOBSCOUT_METRICS_ENABLED=true
